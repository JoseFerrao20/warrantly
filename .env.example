# Copia para .env e ajusta. O .env não vai para o git.
# No dev container, o DATABASE_URL já vem definido no docker-compose.yml.

# Base de dados
DATABASE_URL=postgresql+psycopg://warrantly:warrantly@db:5432/warrantly

# API
# Pelo menos 32 caracteres. Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production

# Token para correr os alertas por HTTP (POST /api/internal/alerts), usado pelo
# agendamento diário no GitHub Actions. Deixar vazio em desenvolvimento.
ALERTS_TOKEN=

# Limite de tentativas no login, no registo e ao apagar a conta. Só se desliga (false)
# para os testes E2E, que criam muitas contas seguidas.
RATE_LIMITS=true

# Notificações push da app móvel nos alertas (serviço do Expo; ver docs/push.md).
# EXPO_ACCESS_TOKEN só é preciso com o "enhanced security" ligado na conta do Expo.
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# Email: "smtp" (acima) ou "ses" (Amazon SES pela API, na AWS)
MAIL_BACKEND=smtp

# Onde ficam as faturas: "local" (pasta UPLOAD_DIR) ou "s3" (ver docs/cloud.md)
STORAGE_BACKEND=local
# Pasta das faturas (relativa à pasta onde a API arranca)
UPLOAD_DIR=uploads
# Com STORAGE_BACKEND=s3:
S3_BUCKET=
AWS_REGION=

# Email (alertas de garantia). No dev container, o Mailpit apanha os emails
# (ver em http://localhost:8025). Em produção, usar os dados do fornecedor de SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Warrantly <alertas@warrantly.local>
