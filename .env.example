# Copia para .env e ajusta. O .env não vai para o git.
# No dev container, o DATABASE_URL já vem definido no docker-compose.yml.

# Base de dados
DATABASE_URL=postgresql+psycopg://warrantly:warrantly@db:5432/warrantly

# API
# Pelo menos 32 caracteres. Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-insecure-secret-key-change-me-in-production

# Email (alertas de garantia) — preencher mais tarde
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
