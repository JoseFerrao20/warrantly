{
  "expo": {
    "name": "Warrantly",
    "slug": "warrantly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.warrantly.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563EB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pt.warrantly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#11171d"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Warrantly usa a câmara para fotografar faturas.",
          "photosPermission": "O Warrantly acede às fotografias para escolheres a fatura."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "scheme": "warrantly",
    "experiments": {
      "typedRoutes": true
    }
  }
}
